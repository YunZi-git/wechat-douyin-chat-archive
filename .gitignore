# ── 隐私：聊天数据、数据库、导出文件一律不进仓库 ──
/data/
*.db
*.db-wal
*.db-shm
exports/
cards/

# app/data 是主题数据等代码资产，不是运行数据
!app/data/
!app/data/*.json

# demo/ 是脚本生成的合成数据，数据库需要进版本库
!demo/**/*.db

# ── Python ──
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.dsh-pyenv/
*.egg-info/

# ── 前端 ──
node_modules/
web/dist/
.vite/

# ── 打包产物 / 本地缓存 ──
dist/
release/
release_staging/
build/
*.spec
.cache/
_scratch/
_audit/

# ── 本地配置 / 密钥（永远不要提交）──
config.json
settings.json
secrets.json
.env
.env.*

# ── 系统 / 编辑器 ──
.DS_Store
Thumbs.db
desktop.ini
*.log
.idea/
.vscode/
